<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Image overlay (hasil filter) -->
    <ImageView
        android:id="@+id/imageResult"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="@android:color/transparent" />

    <!-- Panel Kontrol -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="#80000000">

            <!-- FPS Text -->
            <TextView
                android:id="@+id/tvFps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FPS ~ -"
                android:textColor="@android:color/white" />

            <!-- Radio Buttons Group -->
            <RadioGroup
                android:id="@+id/radioGroupMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:checkedButton="@id/rbDeutan">

                <RadioButton
                    android:id="@+id/rbNormal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Normal"
                    android:textColor="@android:color/white" />

                <RadioButton
                    android:id="@+id/rbProtan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Protan"
                    android:textColor="@android:color/white" />

                <RadioButton
                    android:id="@+id/rbDeutan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Deutan"
                    android:textColor="@android:color/white" />
            </RadioGroup>

            <!-- Toggle Button -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/btnToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Running" />

            <!-- LAB Finishing Switch -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swLab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LAB Finishing (CLAHE)" />

            <!-- Severity -->
            <TextView
                android:id="@+id/tvSeverity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Severity: 1.00"
                android:textColor="@android:color/white" />

            <com.google.android.material.slider.Slider
                android:id="@+id/seekSeverity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:value="1"
                android:valueFrom="0"
                android:valueTo="1" />

            <!-- Boost -->
            <TextView
                android:id="@+id/tvBoost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Boost: 1.00"
                android:textColor="@android:color/white" />

            <com.google.android.material.slider.Slider
                android:id="@+id/seekBoost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:value="1"
                android:valueFrom="0"
                android:valueTo="1" />

        </LinearLayout>
    </ScrollView>

    <!-- Progress Loading -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_gravity="center"
        app:indicatorSize="48dp"
        app:trackThickness="4dp" />

</FrameLayout>
